{
  "name": "DoubigueShare",
  "pkg": "com.doubigue.appshare",
  "versionName": "1.0.0",
  "versionCode": 1,
  "orientation": "auto",
  "color": "#ffffff",
  "fullscreen": false,
  "icon": true,
  "type": "flutter",
  "permissions": [
    "storage",
    "media",
    "allfiles",
    "camera",
    "micro",
    "location",
    "notifications",
    "contacts",
    "calendar",
    "bluetooth",
    "phone"
  ],
  "share": true,
  "askStart": true
}